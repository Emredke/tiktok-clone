PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/velo.sqlite
MEDIA_DIR=./data/media
# Local development only: email links go to data/mail/*.json
MAIL_MODE=development
# Production: set MAIL_MODE=smtp and all SMTP variables
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Velo <hello@example.com>
# Production uploads: S3-compatible object storage. No secrets in the frontend.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production must use STORAGE_DRIVER=s3, MAIL_MODE=smtp, an HTTPS APP_ORIGIN,
# and a mounted persistent database volume. Set TRUST_PROXY only behind a trusted proxy.
TRUST_PROXY=0

# Default startup imports the credited open video collection in the background.
IMPORT_REAL_VIDEOS=1
# Bounded concurrent downloads/encoders; accepted range 1–4.
IMPORT_CONCURRENCY=2
# Run npm run captions:setup for local development. Docker bundles the local model.
CAPTION_MODEL=tiny
CAPTION_MODEL_DIR=./data/models
# Optional override when Python is installed elsewhere:
# CAPTION_PYTHON=/absolute/path/to/venv/bin/python

# Original CC0 music/effects are generated on demand. Browser push is optional.
# Leave both VAPID keys empty to generate persistent private keys in data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
VAPID_FILE=./data/vapid.json
# Daily consistent SQLite snapshots; local retention 7, off-site S3 copies.
BACKUPS_ENABLED=1
BACKUP_DIR=./data/backups
BACKUP_KEEP=7
BACKUP_PREFIX=backups/
# Production skips fictional demo accounts; development retains them.
# SEED_DEMOS=0
